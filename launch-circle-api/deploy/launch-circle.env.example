# Install as /etc/launch-circle/launch-circle.env with mode 0640.
APP_ENV=pilot
SQLITE_DATABASE_URL=sqlite:////var/lib/launch-circle/launch_circle.db
JWT_SECRET=
CORS_ORIGINS=https://pilot.example.com
PUBLIC_BASE_URL=https://pilot.example.com
INVITE_BASE_URL=https://launchcircle.app/join
GOOGLE_GROUP_EMAIL=launch-circle-12-testers@googlegroups.com
GOOGLE_GROUP_URL=https://groups.google.com/g/launch-circle-12-testers
GOOGLE_CLIENT_ID=
DEVELOPMENT_AUTH_ENABLED=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
BACKUP_DESTINATION=/var/backups/launch-circle
BACKUP_RETENTION=14
GOOGLE_PLAY_PACKAGE_NAME=com.launchcircle.testers
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_DEVELOPER_ACCOUNT_ID=
GOOGLE_PLAY_UNLIMITED_DEVELOPER_ACCOUNT_IDS=
GOOGLE_PLAY_ADDITIONAL_APP_PRODUCT_ID=additional_app_1
GOOGLE_PLAY_MANAGED_PRODUCT_ID=managed_launch_15
GOOGLE_PLAY_MANAGED_CREDIT_PRODUCT_ID=managed_launch_14
